{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Grid Leap",
  "version": "0.0.20",
  "identifier": "com.olaidigitalstudios.gridleap.desktop",
  "build": {
    "frontendDist": "../dist/desktop",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:desktop",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "title": "Grid Leap",
        "width": 540,
        "height": 840,
        "minWidth": 540,
        "minHeight": 750,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
