{
  "name": "grid-leap",
  "version": "0.0.14",
  "type": "module",
  "description": "Number Grid Maze puzzle game",
  "scripts": {
    "dev": "vite --mode editor",
    "dev:editor": "vite --mode editor",
    "dev:playstore": "vite --mode playstore",
    "dev:itch": "vite --mode itch",
    "dev:web": "vite --mode web",
    "build": "vite build --mode editor",
    "build:editor": "vite build --mode editor --outDir dist/editor",
    "build:web": "vite build --mode web --outDir dist/web",
    "build:itch": "vite build --mode itch --outDir dist/itch",
    "build:playstore": "vite build --mode playstore --outDir dist && cap sync android",
    "build:apk": "npm run build:playstore && cd android && gradlew.bat assembleDebug",
    "build:aab": "npm run build:playstore && cd android && gradlew.bat bundleRelease",
    "preview": "vite preview",
    "test:daily": "node tests/test-daily-solvability.js",
    "cap:sync": "cap sync android",
    "cap:open": "cap open android"
  },
  "devDependencies": {
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@capacitor-community/in-app-review": "^8.0.0",
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3"
  }
}
